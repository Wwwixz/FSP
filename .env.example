# Образец настроек для подключения нейросети GigaChat (Сбер).
# Скопируйте в `.env` и подставьте реальные значения (см. личный кабинет Studio Сбера).
# ВАЖНО: `.env` входит в .gitignore и не коммитится; этот файл можно коммитить.

# ИИ-провайдер: mock | openai | gigachat
AI_PROVIDER=gigachat

# Authorization key из личного кабинета Studio Сбера (base64 client_id:client_secret)
AI_GIGACHAT_AUTH_KEY=your-authorization-key

# Scope: для физлиц GIGACHAT_API_PERS, для юрлиц GIGACHAT_API_CORP или GIGACHAT_API_B2B
AI_GIGACHAT_SCOPE=GIGACHAT_API_PERS

# OAuth-эндпоинт (получение access_token) и базовый URL чата.
# Chat-completions вызывается по пути {base}/v1/chat/completions
AI_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
AI_GIGACHAT_BASE_URL=https://api.giga.chat

# Модель (список — GET {base}/v1/models): GigaChat-2, GigaChat-3-Pro и др.
AI_GIGACHAT_MODEL=GigaChat-2

# Dev-флаг: отключить строгую проверку TLS-сертификата (сертификаты НУЦ Минцифры).
# НЕ включать в продакшене!
AI_GIGACHAT_INSECURE_SSL=true

# Строгий JSON-режим (response_format=json_object), поддерживается GigaChat
AI_JSON_MODE=true