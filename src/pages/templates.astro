---
import AppLayout from "../layouts/AppLayout.astro";
import CorporateTemplatesList from "../components/CorporateTemplatesList";
---

<AppLayout title="DocHelper — Шаблоны">
  <div class="animate-fade-in rounded-2xl border border-line bg-card p-6 shadow-sm shadow-ink-900/[0.03] sm:p-8">
    <h1 class="text-xl font-semibold text-ink-900">Шаблоны</h1>
    <p class="mt-1 text-sm text-ink-600">
      Выберите шаблон оформления для документа.
    </p>

    <div class="stagger-children mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <!-- Standard -->
      <div class="card-hover group rounded-xl border-2 border-line bg-white p-5 transition-all duration-200 hover:border-accent-200">
        <div class="flex items-start justify-between">
          <div>
            <span class="inline-flex items-center rounded-md bg-accent-50 px-2 py-0.5 text-xs font-medium text-accent-600">Рекомендуемый</span>
            <h3 class="mt-2 text-base font-semibold text-ink-900">Стандартный</h3>
          </div>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-navy-900 text-white transition-transform duration-200 group-hover:scale-110">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <rect x="3" y="2" width="14" height="16" rx="2" stroke="currentColor" strokeWidth="1.4" />
              <path d="M6 6H14M6 9H14M6 12H10" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round" />
            </svg>
          </div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-ink-600">
          Классический строгий стиль. Times New Roman, поля 2 см, стандартные отступы. Подойдёт для большинства служебных записок.
        </p>

        <div class="mt-4 rounded-lg border border-line bg-surface/50 p-3">
          <div class="space-y-1.5">
            <div class="h-1.5 w-3/4 rounded-full bg-ink-400/40" />
            <div class="h-1.5 w-full rounded-full bg-ink-400/30" />
            <div class="h-1.5 w-5/6 rounded-full bg-ink-400/30" />
            <div class="h-1.5 w-2/3 rounded-full bg-ink-400/30" />
          </div>
          <div class="mt-3 flex gap-3 text-[10px] text-ink-400">
            <span>Шрифт: Times New Roman</span>
            <span>Размер: 14pt</span>
          </div>
        </div>

        <a
          href="/"
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent-600 transition-colors hover:text-accent-500"
        >
          Использовать
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M5 3L9 7L5 11" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round" />
          </svg>
        </a>
      </div>

      <!-- Modern -->
      <div class="card-hover group rounded-xl border-2 border-line bg-white p-5 transition-all duration-200 hover:border-accent-200">
        <div class="flex items-start justify-between">
          <div>
            <span class="inline-flex items-center rounded-md bg-navy-900/10 px-2 py-0.5 text-xs font-medium text-navy-800">Современный</span>
            <h3 class="mt-2 text-base font-semibold text-ink-900">Современный</h3>
          </div>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-600 text-white transition-transform duration-200 group-hover:scale-110">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <rect x="3" y="2" width="14" height="16" rx="2" stroke="currentColor" strokeWidth="1.4" />
              <circle cx="10" cy="7" r="2.5" stroke="currentColor" strokeWidth="1.2" />
              <path d="M6 14H14" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round" />
            </svg>
          </div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-ink-600">
          Более лаконичный дизайн. Calibri, цветные акценты, современная вёрстка. Для неформальных внутренних документов.
        </p>

        <div class="mt-4 rounded-lg border border-line bg-surface/50 p-3">
          <div class="space-y-1.5">
            <div class="h-1.5 w-2/3 rounded-full bg-accent-500/40" />
            <div class="h-1.5 w-full rounded-full bg-ink-400/30" />
            <div class="h-1.5 w-4/5 rounded-full bg-ink-400/30" />
            <div class="h-1.5 w-1/2 rounded-full bg-ink-400/30" />
          </div>
          <div class="mt-3 flex gap-3 text-[10px] text-ink-400">
            <span>Шрифт: Calibri</span>
            <span>Размер: 12pt</span>
          </div>
        </div>

        <a
          href="/"
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent-600 transition-colors hover:text-accent-500"
        >
          Использовать
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M5 3L9 7L5 11" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round" />
          </svg>
        </a>
      </div>
    </div>

    <CorporateTemplatesList client:load />
  </div>
</AppLayout>
