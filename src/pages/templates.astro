---
import AppLayout from "../layouts/AppLayout.astro";

const templates = [
  {
    title: "Стандартный",
    description: "Классический строгий стиль. Подойдёт для большинства служебных записок.",
    accent: false,
  },
  {
    title: "Современный",
    description: "Более лаконичный дизайн с современной вёрсткой и шрифтом.",
    accent: true,
  },
];
---

<AppLayout title="DocHelper — Шаблоны">
  <div class="rounded-2xl border border-line bg-card p-6 shadow-sm shadow-ink-900/[0.03]">
    <h1 class="text-xl font-semibold text-ink-900">Шаблоны</h1>
    <p class="mt-1 text-sm text-ink-600">
      Выберите шаблон оформления по умолчанию для новых документов.
    </p>

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {templates.map((tpl) => (
        <div class="rounded-xl border border-line bg-white p-4">
          <div class="flex gap-2">
            {[0, 1].map((i) => (
              <div class="flex-1 rounded-md border border-line bg-surface p-2">
                <div
                  class:list={[
                    "rounded-full",
                    tpl.accent ? "h-2 w-2/3 bg-accent-500/60" : "h-1.5 w-3/4 bg-ink-400/50",
                  ]}
                />
                <div class="mt-2 space-y-1">
                  {[0, 1, 2, 3].map((line) => (
                    <div class="h-1 rounded-full bg-ink-400/30" style={`width: ${90 - line * 12}%`} />
                  ))}
                </div>
              </div>
            ))}
          </div>
          <p class="mt-3 text-sm font-medium text-ink-900">{tpl.title}</p>
          <p class="mt-1 text-xs leading-relaxed text-ink-600">{tpl.description}</p>
          <a
            href="/"
            class="mt-3 inline-block text-xs font-medium text-accent-600 hover:underline"
          >
            Использовать в новом документе →
          </a>
        </div>
      ))}
    </div>
  </div>
</AppLayout>
