---
import AppLayout from "../layouts/AppLayout.astro";
import DocumentsList from "../components/DocumentsList";
---

<AppLayout title="DocHelper — Мои документы">
  <div class="animate-fade-in rounded-2xl border border-line bg-card p-6 shadow-sm shadow-ink-900/[0.03] sm:p-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-semibold text-ink-900">Мои документы</h1>
        <p class="mt-1 text-sm text-ink-600">Все документы, созданные в DocHelper.</p>
      </div>
      <a
        href="/"
        class="btn-press inline-flex items-center gap-2 rounded-xl bg-accent-600 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-500"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M7 2.5V11.5M2.5 7H11.5" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" />
        </svg>
        <span class="hidden sm:inline">Создать документ</span>
      </a>
    </div>

    <div class="mt-6">
      <DocumentsList client:load />
    </div>
  </div>
</AppLayout>
