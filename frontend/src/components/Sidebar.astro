---
interface NavItem {
  label: string;
  href: string;
  icon: "create" | "documents" | "templates" | "settings";
}

const navItems: NavItem[] = [
  { label: "Создать документ", href: "/", icon: "create" },
  { label: "Мои документы", href: "/documents", icon: "documents" },
  { label: "Шаблоны", href: "/templates", icon: "templates" },
  { label: "Настройки", href: "/settings", icon: "settings" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<aside class="flex h-full w-64 shrink-0 flex-col justify-between bg-navy-900 px-3 py-5 text-white">
  <div>
    <div class="mb-8 flex items-center gap-2.5 px-3 pt-1">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent-600/20">
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="3" y="1.5" width="16" height="19" rx="2" stroke="#60a5fa" stroke-width="1.6" />
          <path d="M7 6.5H15" stroke="#60a5fa" stroke-width="1.6" stroke-linecap="round" />
          <path d="M7 10.5H15" stroke="#60a5fa" stroke-width="1.6" stroke-linecap="round" />
          <path d="M7 14.5H11.5" stroke="#60a5fa" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </div>
      <span class="text-base font-semibold tracking-tight">DocHelper</span>
    </div>

    <nav class="flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition-all duration-200",
            isActive(item.href)
              ? "bg-accent-600 text-white shadow-lg shadow-accent-600/25"
              : "text-white/60 hover:bg-white/[0.06] hover:text-white/90",
          ]}
        >
          <span class:list={[
            "flex h-7 w-7 shrink-0 items-center justify-center rounded-lg transition-colors duration-200",
            isActive(item.href) ? "bg-white/15" : "bg-white/[0.04] group-hover:bg-white/[0.08]",
          ]}>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              {item.icon === "create" && (
                <>
                  <rect x="3" y="1.5" width="10" height="13" rx="1.4" stroke="currentColor" stroke-width="1.3" />
                  <path d="M5.5 5.5H10.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                  <path d="M5.5 8H10.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                </>
              )}
              {item.icon === "documents" && (
                <>
                  <path d="M4 2H9.5L12.5 5V13.5C12.5 14.05 12.05 14.5 11.5 14.5H4.5C3.95 14.5 3.5 14.05 3.5 13.5V2.5C3.5 1.95 3.95 2 4 2Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                  <path d="M9.3 2V5H12.3" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                </>
              )}
              {item.icon === "templates" && (
                <>
                  <rect x="2" y="2.5" width="5" height="5" rx="0.8" stroke="currentColor" stroke-width="1.3" />
                  <rect x="9" y="2.5" width="5" height="5" rx="0.8" stroke="currentColor" stroke-width="1.3" />
                  <rect x="2" y="9.5" width="5" height="4" rx="0.8" stroke="currentColor" stroke-width="1.3" />
                  <rect x="9" y="9.5" width="5" height="4" rx="0.8" stroke="currentColor" stroke-width="1.3" />
                </>
              )}
              {item.icon === "settings" && (
                <>
                  <circle cx="8" cy="8" r="2.3" stroke="currentColor" stroke-width="1.3" />
                  <path
                    d="M8 2.2v1.4M8 12.4v1.4M13.8 8h-1.4M3.6 8H2.2M11.9 4.1l-1 1M5.1 10.9l-1 1M11.9 11.9l-1-1M5.1 5.1l-1-1"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                  />
                </>
              )}
            </svg>
          </span>
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <div class="px-1">
    <a
      href="/help"
      aria-current={isActive("/help") ? "page" : undefined}
      class:list={[
        "group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition-all duration-200",
        isActive("/help") ? "bg-white/10 text-white" : "text-white/50 hover:bg-white/[0.06] hover:text-white/80",
      ]}
    >
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-white/[0.04] group-hover:bg-white/[0.08] transition-colors duration-200">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.4" />
          <path
            d="M6.2 6.2c0-1 .8-1.8 1.8-1.8s1.8.7 1.8 1.6c0 1.1-1.2 1.2-1.6 2.1"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          />
          <circle cx="8" cy="11.3" r="0.4" fill="currentColor" />
        </svg>
      </span>
      Помощь
    </a>
  </div>
</aside>
